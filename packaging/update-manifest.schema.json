{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rust-harness/update-manifest.schema.json",
  "title": "Rust Harness update manifest",
  "type": "object",
  "required": ["version", "artifacts", "issued_at", "signature"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Numeric release version. A check compares it with the running app's version, component by component."
    },
    "channel": {
      "type": "string",
      "description": "Release channel, for example stable or beta."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["os", "arch", "url", "sha256", "size"],
        "properties": {
          "os": {
            "type": "string",
            "enum": ["macos", "linux"]
          },
          "arch": {
            "type": "string",
            "enum": ["aarch64", "x86_64"]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "notes_url": {
      "type": "string",
      "format": "uri"
    },
    "issued_at": {
      "type": "integer",
      "description": "Release time in seconds since the Unix epoch."
    },
    "signature": {
      "type": "string",
      "description": "Base64 Ed25519 signature over the canonical JSON of every other field."
    }
  },
  "additionalProperties": true
}
